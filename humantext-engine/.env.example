# ╔══════════════════════════════════════════════════════════════════╗
# ║  HumanText Engine — Environment Variables                       ║
# ║  Copy this file to .env and fill in your values.                ║
# ║  NEVER commit .env to version control.                          ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── LLM Provider API Keys ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Observability ──
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=humantext-engine
LANGSMITH_TRACING=true

# ── Model Configuration ──
PRIMARY_MODEL=gpt-4o
ANALYSIS_MODEL=gpt-4o-mini
VALIDATION_MODEL=gpt-4o-mini
REWRITE_MODEL=gpt-4o
REVISION_MODEL=gpt-4o
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Quality Thresholds ──
SEMANTIC_THRESHOLD=0.85
FACT_THRESHOLD=0.95
STYLE_THRESHOLD=0.70
NATURALNESS_THRESHOLD=0.70
QUALITY_THRESHOLD=0.75

# ── Limits ──
MAX_REVISIONS=3
MAX_INPUT_LENGTH=50000
MAX_OUTPUT_TOKENS=8192
REQUEST_TIMEOUT=120

# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Database (optional, for Writing DNA persistence) ──
# DATABASE_URL=postgresql://user:pass@localhost:5432/humantext
# REDIS_URL=redis://localhost:6379/0
